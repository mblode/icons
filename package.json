{
  "name": "blode-icons",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "check:types": "turbo run check:types",
    "release": "turbo run build --filter=blode-icons-react && changeset publish",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "portless": "^0.15.1",
    "turbo": "^2",
    "ultracite": "7.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.1"
}

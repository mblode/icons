{
  "compilerOptions": {
    "jsx": "react",
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}

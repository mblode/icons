{
  "name": "blode-icons-react",
  "version": "0.4.1",
  "description": "Blode icons for React — drop-in lucide-react replacement",
  "keywords": [
    "blode",
    "component",
    "icons",
    "lucide",
    "lucide-react",
    "react",
    "svg",
    "ui"
  ],
  "homepage": "https://icons.blode.co",
  "bugs": {
    "url": "https://github.com/mblode/blode-icons/issues"
  },
  "license": "MIT",
  "author": "Matthew Blode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/blode-icons.git",
    "directory": "packages/blode-icons-react"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./dynamic": {
      "types": "./dist/dynamic.d.ts",
      "import": "./dist/dynamic.js"
    },
    "./dynamicIconImports": {
      "types": "./dist/dynamicIconImports.d.ts",
      "import": "./dist/dynamicIconImports.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-icons.mjs",
    "validate:icons-data": "node scripts/validate-icons-data.mjs",
    "enrich": "node scripts/enrich-icons-data.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "check:types": "tsc --noEmit",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "ultracite fix",
    "format:check": "ultracite check"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/react": "^19.2.17",
    "typescript": "7.0.2",
    "ultracite": "7.9.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  }
}
